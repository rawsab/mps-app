# Browser-safe configuration only. Everything prefixed VITE_ is bundled into public JavaScript.
# Never put a service-role / sb_secret_ key or a Resend key here (NFR-02).
#
# Local values: run `pnpm exec supabase status` and copy the API URL and the
# publishable (or anon) key into .env.local.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Used only by `pnpm test:api` (Node, never bundled). Defaults to the local stack.
# SUPABASE_TEST_URL=http://127.0.0.1:54321
# SUPABASE_TEST_PUBLISHABLE_KEY=
